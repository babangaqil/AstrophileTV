<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030508"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <!-- ── HEADER ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTROPHILE"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#00f5ff"
            android:letterSpacing="0.25"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV MONITOR · SETUP"
            android:textSize="10sp"
            android:textColor="#2a4a70"
            android:letterSpacing="0.35"
            android:layout_marginBottom="28dp"/>

        <!-- ── INPUT CARD ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <!-- Nomor TV & Nama TV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Nomor TV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOMOR TV"
                        android:textSize="9sp"
                        android:textColor="#3a6090"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etTvNum"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="1"
                        android:textColorHint="#2a4060"
                        android:textColor="#e8f4ff"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/input_bg"
                        android:padding="14dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Nama TV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAMA TV"
                        android:textSize="9sp"
                        android:textColor="#3a6090"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etTvName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TV 1"
                        android:textColorHint="#2a4060"
                        android:textColor="#e8f4ff"
                        android:textSize="14sp"
                        android:background="@drawable/input_bg"
                        android:padding="14dp"
                        android:gravity="center"
                        android:inputType="text"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Nama Toko -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAMA TOKO"
                android:textSize="9sp"
                android:textColor="#3a6090"
                android:letterSpacing="0.2"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNamaToko"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ASTROPHILE"
                android:textColorHint="#2a4060"
                android:textColor="#e8f4ff"
                android:textSize="14sp"
                android:background="@drawable/input_bg"
                android:padding="14dp"
                android:gravity="center"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:layout_marginBottom="20dp"/>

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="⚡  HUBUNGKAN &amp; MULAI MONITOR"
                android:textColor="#00f5ff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:background="@drawable/btn_connect_bg"/>

        </LinearLayout>

        <!-- ── INFO CARD ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- IP LAN -->
            <TextView
                android:id="@+id/tvIpInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#00ff88"
                android:gravity="center"
                android:layout_marginBottom="10dp"
                android:visibility="gone"/>

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="○ Monitor Tidak Aktif"
                android:textSize="13sp"
                android:textColor="#ffcc00"
                android:gravity="center"
                android:layout_marginBottom="4dp"/>

            <!-- Versi -->
            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="10sp"
                android:textColor="#2a4a6a"
                android:gravity="center"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ── ACTION BUTTONS ── -->

        <!-- Download Update -->
        <Button
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⬇  DOWNLOAD UPDATE TERBARU"
            android:textColor="#00f5ff"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#071525"
            android:layout_marginBottom="10dp"/>

        <!-- Force Stop -->
        <Button
            android:id="@+id/btnForceStop"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="⏹  PAKSA BERHENTI"
            android:textColor="#ff4d6d"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#120508"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode LAN · Config tersimpan otomatis"
            android:textSize="9sp"
            android:textColor="#1a3050"
            android:letterSpacing="0.1"/>

    </LinearLayout>
</ScrollView>
