<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#03050c"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <!-- ── Header ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASTROPHILE"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#00f5ff"
            android:letterSpacing="0.25"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TV MONITOR · SETUP"
            android:textSize="10sp"
            android:textColor="#2a4a70"
            android:letterSpacing="0.3"
            android:layout_marginBottom="8dp"/>

        <!-- IP Badge -->
        <TextView
            android:id="@+id/tvIpInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#00cc66"
            android:background="#081810"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginBottom="28dp"
            android:visibility="gone"/>

        <!-- ── Main Card ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <!-- Nomor TV + Nama TV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <!-- Nomor TV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOMOR TV"
                        android:textSize="9sp"
                        android:textColor="#3a5a80"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etTvNum"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="1"
                        android:textColorHint="#2a3a50"
                        android:textColor="#e0f4ff"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/input_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:inputType="number"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- Nama TV -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NAMA TV"
                        android:textSize="9sp"
                        android:textColor="#3a5a80"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/etTvName"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="TV 1"
                        android:textColorHint="#2a3a50"
                        android:textColor="#e0f4ff"
                        android:textSize="14sp"
                        android:background="@drawable/input_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:gravity="center"
                        android:inputType="text"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Nama Toko -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NAMA TOKO"
                android:textSize="9sp"
                android:textColor="#3a5a80"
                android:letterSpacing="0.2"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etNamaToko"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="ASTROPHILE"
                android:textColorHint="#2a3a50"
                android:textColor="#e0f4ff"
                android:textSize="14sp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center"
                android:inputType="textCapCharacters"
                android:singleLine="true"
                android:layout_marginBottom="20dp"/>

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="⚡  HUBUNGKAN &amp; MULAI MONITOR"
                android:textColor="#00f5ff"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15"
                android:background="@drawable/btn_connect_bg"
                android:layout_marginBottom="14dp"/>

            <!-- Status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="12sp"
                android:textColor="#00ff88"
                android:gravity="center"
                android:minHeight="20dp"/>

            <!-- Device Info (HW ID, versi) -->
            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="9sp"
                android:textColor="#1e3a50"
                android:gravity="center"
                android:layout_marginTop="6dp"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- ── Download Update Button ── -->
        <Button
            android:id="@+id/btnDownloadUpdate"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⬇  DOWNLOAD UPDATE TERBARU"
            android:textColor="#00f5ff"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#080e1c"
            android:layout_marginBottom="8dp"/>

        <!-- ── Force Stop Button ── -->
        <Button
            android:id="@+id/btnForceStop"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="⏹  PAKSA BERHENTI APLIKASI"
            android:textColor="#ff4d6d"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:backgroundTint="#120408"
            android:layout_marginBottom="16dp"/>

        <!-- Footer note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Config tersimpan otomatis · LAN Only"
            android:textSize="9sp"
            android:textColor="#0e1e30"
            android:letterSpacing="0.1"/>

    </LinearLayout>
</ScrollView>
