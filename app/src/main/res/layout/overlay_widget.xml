<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="end"
    android:padding="10dp">

    <!-- Box card timer (existing) -->
    <FrameLayout
        android:id="@+id/widgetBg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_bg_normal"
        android:padding="10dp">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvWidgetIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9201;"
                android:textSize="20sp"
                android:layout_marginEnd="8dp"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvWidgetTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#00f5ff"
                    android:letterSpacing="0.08"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/tvWidgetLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SISA WAKTU"
                    android:textSize="10sp"
                    android:textColor="#5a80a8"
                    android:letterSpacing="0.2"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Box status bayar — terpisah di bawah, gap 6dp -->
    <TextView
        android:id="@+id/tvWidgetBayar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_gravity="end"
        android:background="@drawable/widget_bg_normal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="BELUM BAYAR"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#ff2d6e"
        android:letterSpacing="0.15"
        android:fontFamily="monospace"
        android:gravity="center"
        android:visibility="gone"/>

</LinearLayout>
